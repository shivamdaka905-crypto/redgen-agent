# LLM provider (any OpenAI-compatible endpoint)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_API_KEY=

# Image generation (OpenAI-compatible /images/generations endpoint)
IMAGE_API_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# YouTube read-only (optional: or connect Google via /api/connect/google)
YOUTUBE_API_KEY=

# Agent identity
OWNER_NAME=Shivam
BUSINESS_NAME=RED GEN DEVELOPMENT

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=redgen-verify

# Server
PORT=8000
